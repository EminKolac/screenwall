# ---- Core ----
APP_ENV=development
STORAGE_ROOT=./data
MAX_UPLOAD_MB=50
MAX_ITERATIONS=2

# ---- Privacy auditor (LOCAL ONLY) ----
# provider: ollama | mlx | llamacpp
AUDITOR_PROVIDER=ollama
AUDITOR_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://localhost:11434
AUDITOR_RISK_APPROVE=low            # max risk_level still allowed to auto-approve

# ---- NLP / recognizers ----
SPACY_EN_MODEL=en_core_web_sm

# ---- Chat (USED ONLY AFTER APPROVAL, fully local) ----
CHAT_PROVIDER=ollama
CHAT_OLLAMA_MODEL=qwen3.5:4b        # same model as the auditor — one set of weights resident
