# Fable settings. Copy to backend/.env (the backend reads .env from its own directory).
# Every value below is the default; leave a line out to keep it.

# ---- Core ----
STORAGE_ROOT=./data
MAX_UPLOAD_MB=50
# mapping: keeps the original and the placeholder map on this computer (reviewable, reversible)
# destructive: never writes the original or the map (irreversible)
ANONYMIZATION_MODE=mapping

# ---- Privacy auditor (always local) ----
AUDITOR_PROVIDER=ollama
AUDITOR_MODEL=qwen3.5:4b
# Only a loopback address is used unless OLLAMA_ALLOW_REMOTE=true. Without it, a remote URL makes
# every audit fail closed (documents wait for review) and Ollama chat unavailable. With it, the
# masked text of every upload goes to that host for auditing, and chat asks for consent first.
# Ollama "cloud" models (names ending -cloud or :cloud) are always refused.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ALLOW_REMOTE=false

# ---- Term lists ----
# Comma-separated. Global lists are easier to manage in the app (Ayarlar), which stores them in
# STORAGE_ROOT/user_settings.json. The evaluation harness turns every list off (TERM_LISTS=false).
DENY_TERMS=
ALLOW_TERMS=

# ---- Chat (approved documents only, masked text only) ----
# ollama: this computer. claude_cli / codex_cli: the cloud, through your own CLI login; every
# question shows the exact text first and needs your consent. Fable stores no API key.
CHAT_DEFAULT_PROVIDER=ollama
CHAT_OLLAMA_MODEL=qwen3.5:4b
# Empty means the CLI's own default model.
CHAT_CLAUDE_MODEL=
CHAT_CODEX_MODEL=
CHAT_CLI_TIMEOUT_S=60

# ---- Local web security ----
# The UI's origin (start.sh and `npm run dev` use port 5174). No other page may call the API.
CORS_ALLOW_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
ALLOWED_HOSTS=localhost,127.0.0.1
