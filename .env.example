# ---- Core ----
APP_ENV=development
STORAGE_ROOT=./data
MAX_UPLOAD_MB=50
MAX_ITERATIONS=3

# ---- Privacy auditor (LOCAL ONLY) ----
# provider: ollama | mlx | llamacpp
AUDITOR_PROVIDER=ollama
AUDITOR_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434
AUDITOR_RISK_APPROVE=low            # max risk_level still allowed to auto-approve

# ---- NLP / recognizers ----
SPACY_EN_MODEL=en_core_web_lg
TR_NER_MODEL=savasy/bert-base-turkish-ner-cased
LANG_DETECTOR=langdetect            # langdetect | fasttext

# ---- External chat (USED ONLY AFTER APPROVAL) ----
# provider: openai | anthropic | azure
CHAT_PROVIDER=anthropic
CHAT_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
