# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Env / secrets
.env
.env.*
!.env.example

# Runtime storage — NEVER commit documents or PII
/data/**
!/data/**/.gitkeep
# dated copies of the document layers taken before a storage migration
/backend/data-backup-*/


# Models / large artifacts (root-level only — must not match backend/app/models/)
*.gguf
/models/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
# the v1 UI's last build output, kept on disk when the v2 build replaced it
/archive/frontend-v1/dist-prebuild/

# OS / editor
.DS_Store
.idea/
.vscode/
*.log

# runtime storage created when running from backend/
/backend/data/*
# İSTİSNA — GoldBench test korpusu commit EDİLİR: dosyalar tamamen sentetiktir
# (üretici: backend/evaluation/goldbench/generate.py), gerçek kişisel veri içermez.
# Benchmark'ın üçüncü taraflarca korpus yeniden üretilmeden doğrulanabilmesi için gerekli.
# Kademeli açma: git yok sayılan bir dizinin İÇİNE bakmadığı için önce dizini, sonra
# içindekileri açmak gerekiyor. work/ ve results/ (işlenmiş belge + koşu çıktısı) KAPALI kalır.
!/backend/data/goldbench/
/backend/data/goldbench/*
!/backend/data/goldbench/docs/
!/backend/data/goldbench/gold/
!/backend/data/goldbench/holdout_gold/
!/backend/data/goldbench/inference/

# deney yedekleri (gecici)
thoughts/.backup/
thoughts/.exploop_backup/

# local agent settings and build output
.claude/
dist/
# evaluation runs: new run folders stay local and are added on purpose (git add -f);
# folders that are already tracked stay tracked
/backend/evaluation/results/*/
