#!/usr/bin/env python3
"""Fake `claude` CLI for Fable's chat tests. Never contacts any service.

The child environment is filtered by app/chat/cli.py, so the behaviour is chosen by
`claude.scenario.json` next to this file: {"mode": ..., "answer": ...}. Every invocation is
appended to `claude.calls.jsonl` (argv, cwd and its listing, the full environment, process ids,
and stdin as text + base64 so tests can compare exact bytes).

Modes: success | tool_use | tools_enabled | error_result | exit_error | timeout | flood |
logged_out | old_help | mcp_tool_use | tool_result | no_init | init_without_tools | thinking |
rate_limited
"""
import base64
import json
import os
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
NAME = "claude"
FLAGS = [
    "--safe-mode",
    "--restricted",
    "--tools",
    "--no-session-persistence",
    "--system-prompt-snapshot",
    "--permission-prompts",
    "--strict-mcp-config",
    "--setting-sources",
    "--permission-mode",
]
SESSION = "5d2f7c1e-3b1a-4c55-9f0e-7a61c2d4e8b0"
MODEL = "claude-sonnet-4-5-20250929"


def scenario() -> dict:
    path = HERE / f"{NAME}.scenario.json"
    return json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}


def record(raw_stdin: bytes) -> None:
    entry = {
        "argv": sys.argv[1:],
        "cwd": os.getcwd(),
        "cwd_listing": sorted(os.listdir(".")),
        "env": dict(os.environ),
        "pid": os.getpid(),
        "pgid": os.getpgid(0),
        "stdin": raw_stdin.decode("utf-8", "replace"),
        "stdin_b64": base64.b64encode(raw_stdin).decode("ascii"),
    }
    with open(HERE / f"{NAME}.calls.jsonl", "a", encoding="utf-8") as log:
        log.write(json.dumps(entry, ensure_ascii=False) + "\n")


def emit(*events: dict) -> None:
    for event in events:
        sys.stdout.write(json.dumps(event, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def init_event(tools: list) -> dict:
    return {
        "type": "system",
        "subtype": "init",
        "cwd": os.getcwd(),
        "session_id": SESSION,
        "tools": tools,
        "mcp_servers": [],
        "model": MODEL,
        "permissionMode": "dontAsk",
        "slash_commands": [],
        "apiKeySource": "none",
        "output_style": "default",
        "uuid": "0c6b8f5e-1111-4a2b-8c3d-000000000001",
    }


def assistant_event(content: list) -> dict:
    return {
        "type": "assistant",
        "message": {
            "id": "msg_01FakeFableTest",
            "type": "message",
            "role": "assistant",
            "model": MODEL,
            "content": content,
            "stop_reason": None,
            "stop_sequence": None,
            "usage": {"input_tokens": 812, "output_tokens": 24},
        },
        "parent_tool_use_id": None,
        "session_id": SESSION,
        "uuid": "0c6b8f5e-1111-4a2b-8c3d-000000000002",
    }


def result_event(answer: str, *, is_error: bool = False) -> dict:
    return {
        "type": "result",
        "subtype": "success",
        "is_error": is_error,
        "duration_ms": 2310,
        "duration_api_ms": 2204,
        "num_turns": 1,
        "result": answer,
        "session_id": SESSION,
        "total_cost_usd": 0.0041,
        "usage": {"input_tokens": 812, "output_tokens": 24},
        "permission_denials": [],
        "uuid": "0c6b8f5e-1111-4a2b-8c3d-000000000003",
    }


def user_event(content: list) -> dict:
    return {
        "type": "user",
        "message": {"role": "user", "content": content},
        "parent_tool_use_id": None,
        "session_id": SESSION,
        "uuid": "0c6b8f5e-1111-4a2b-8c3d-000000000004",
    }


def rate_limit_event() -> dict:
    return {
        "type": "rate_limit_event",
        "rate_limit_info": {"status": "allowed", "resetsAt": 1790300000,
                            "rateLimitType": "five_hour"},
        "uuid": "0c6b8f5e-1111-4a2b-8c3d-000000000005",
        "session_id": SESSION,
    }


def stream_scenario(mode: str, answer: str) -> list[dict] | None:
    """Well-formed streams that differ only in what the model or the CLI did."""
    text = {"type": "text", "text": answer}
    if mode == "mcp_tool_use":
        tool = {"type": "mcp_tool_use", "id": "mcptoolu_01Fake", "name": "read_file",
                "server_name": "files", "input": {"path": "/etc/hosts"}}
        return [init_event([]), assistant_event([tool, text]), result_event(answer)]
    if mode == "tool_result":
        result = {"type": "tool_result", "tool_use_id": "toolu_01Fake", "content": "hosts"}
        return [init_event([]), user_event([result]), assistant_event([text]),
                result_event(answer)]
    if mode == "no_init":
        return [assistant_event([text]), result_event(answer)]
    if mode == "init_without_tools":
        init = init_event([])
        del init["tools"]
        return [init, assistant_event([text]), result_event(answer)]
    if mode == "thinking":
        thought = {"type": "thinking", "thinking": "Kaynak S1'e bakıyorum.", "signature": "c2ln"}
        return [init_event([]), assistant_event([thought, text]), result_event(answer)]
    if mode == "rate_limited":
        return [init_event([]), rate_limit_event(), assistant_event([text]),
                result_event(answer)]
    return None


def chat(mode: str, answer: str) -> int:
    events = stream_scenario(mode, answer)
    if events is not None:
        emit(*events)
        return 0
    if mode == "timeout":
        grandchild = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(120)"])
        pids = {"child": os.getpid(), "grandchild": grandchild.pid}
        (HERE / f"{NAME}.pids.json").write_text(json.dumps(pids), encoding="utf-8")
        time.sleep(120)
        return 0
    if mode == "flood":
        line = "x" * 8191 + "\n"
        for _ in range(128):  # 1 MiB, twice the output limit
            sys.stdout.write(line)
        sys.stdout.flush()
        return 0
    if mode == "exit_error":
        detail = "CANARY-STDERR-DETAIL rate limited for account canary@example.invalid"
        print(detail, file=sys.stderr)
        return 1
    if mode == "tool_use":
        tool = {"type": "tool_use", "id": "toolu_01Fake", "name": "Bash",
                "input": {"command": "ls"}}
        emit(init_event([]), assistant_event([tool]), result_event(answer))
        return 0
    if mode == "tools_enabled":
        emit(init_event(["Bash", "Read"]), assistant_event([{"type": "text", "text": answer}]))
        emit(result_event(answer))
        return 0
    if mode == "error_result":
        emit(init_event([]), result_event("API Error: overloaded", is_error=True))
        return 0
    emit(init_event([]), assistant_event([{"type": "text", "text": answer}]), result_event(answer))
    return 0


def main() -> int:
    current = scenario()
    mode = current.get("mode", "success")
    raw_stdin = sys.stdin.buffer.read()
    record(raw_stdin)
    args = sys.argv[1:]
    if args == ["--version"]:
        print("2.1.280 (Claude Code)")
        return 0
    if args == ["--help"]:
        flags = [f for f in FLAGS if not (mode == "old_help" and f == "--safe-mode")]
        print("Usage: claude [options] [command] [prompt]\n\nOptions:")
        print("\n".join(f"  {flag}" for flag in flags))
        return 0
    if args == ["auth", "status"]:
        if mode == "logged_out":
            print(json.dumps({"loggedIn": False, "authMethod": "none"}))
            return 1
        account = {
            "loggedIn": True,
            "authMethod": "claude.ai",
            "email": "canary-account@example.invalid",
            "orgId": "org-canary-secret",
            "subscriptionType": "max",
        }
        print(json.dumps(account))
        return 0
    if "--print" not in args:
        print("fake claude: unexpected invocation", file=sys.stderr)
        return 2
    return chat(mode, current.get("answer", "Sözleşmeyi <PERSON_1> imzaladı [S1]."))


if __name__ == "__main__":
    sys.exit(main())
